LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Browser tools (Playwright). All optional; these are the defaults.
# Set BROWSER_HEADLESS=0 to watch the browser on your own machine.
BROWSER_HEADLESS=1
# Comma-separated domain allowlist. Empty means the whole public web.
BROWSER_ALLOWLIST=
# Only set this for local fixture sites; it lets the agent reach localhost.
BROWSER_ALLOW_PRIVATE=0
BROWSER_MAX_ELEMENTS=60
BROWSER_NAV_TIMEOUT_MS=20000
BROWSER_ACTION_TIMEOUT_MS=5000
# Drop images, fonts, and media for faster page loads. Some sites look worse.
BROWSER_BLOCK_MEDIA=0
# Only needed in containers that cannot use Chromium's sandbox.
BROWSER_NO_SANDBOX=0
